{
  // Terminal > Run Task...
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests: mvn verify (Unit + Integration)",
      "type": "shell",
      "command": "mvn -B clean verify",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: Image bauen",
      "type": "shell",
      "command": "docker build -t refcard01 .",
      "problemMatcher": []
    },
    {
      "label": "Docker: Container starten (localhost:8080)",
      "type": "shell",
      "command": "docker run --rm -p 8080:8080 --name refcard01 refcard01",
      "dependsOn": "Docker: Image bauen",
      "problemMatcher": []
    }
  ]
}
